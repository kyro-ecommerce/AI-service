# Local integration: AI Python on Windows, backend Docker Compose.
# These are the AI compose DB defaults; use your own DB credentials if different.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ai_service
# Use the BACKEND broker, not the standalone AI broker on 5673.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_URL=redis://localhost:6379/0
# Backend catalog is reached through the published gateway, not auth port 8081.
CATALOG_SERVICE_URL=http://localhost:8080
# Explicit local-only reference to the existing backend shared secret.
# Do not commit actual secrets. An INTERNAL_API_TOKEN environment value overrides this.
KYRO_BACKEND_ENV_FILE=../kyro_backend/.env

# Keep explicit model IDs; availability must be checked with your own API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Embeddings require a verified, lowercase 40-hex Hugging Face commit SHA.
# Intentionally unset: do not insert a fictitious SHA, main or latest.
# Existing list-returning callers also fail explicitly until this is configured.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=
